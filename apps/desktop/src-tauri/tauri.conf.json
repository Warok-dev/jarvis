{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "dev.warok.jarvis",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build:web --prefix ../.."
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/wakeword/*.onnx": "wakeword/"
    }
  }
}
