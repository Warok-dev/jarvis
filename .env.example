# Copie ce fichier en .env et remplis les valeurs. Ne jamais committer .env.
# Brightspace > Calendrier > S'abonner > Tous les calendriers
BRIGHTSPACE_ICAL_URL=

# Supabase > Project Settings > API Keys
SUPABASE_URL=
# Clé secrète (sb_secret_... ou service_role) : worker uniquement, jamais dans les apps.
SUPABASE_SECRET_KEY=
SUPABASE_USER_ID=

# Généré par Claude : secret partagé entre pg_cron et la fonction sync-brightspace
CRON_SECRET=
# Supabase > Account > Access Tokens : pour déployer les fonctions avec la CLI
SUPABASE_ACCESS_TOKEN=
